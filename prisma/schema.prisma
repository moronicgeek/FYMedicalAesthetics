// Patient-identifying and health fields are never stored in plain text.
// They live in AES-256-GCM encrypted columns (see src/lib/crypto.ts).
// Lookup columns (*Hash) hold keyed HMACs so we can find a patient by
// email, phone or ID number without decrypting every record.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x is the engine AWS Amplify's Node runtime needs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PRACTITIONER
  RECEPTION
}

enum CaseType {
  IV_DRIP
  AESTHETICS
  LASER
}

// The client checks in with their name, ID number and treatment (QUEUED). A
// practitioner picks them up and records their details, medical history and,
// for an IV drip, vitals (ASSESSMENT). The patient only signs once cleared.
// IV drip: QUEUED -> ASSESSMENT -> AWAITING_DOCTOR -> AWAITING_SIGNATURE -> IN_PROGRESS -> READY_TO_CLOSE -> CLOSED
//          vitals out of range: ASSESSMENT -> REFERRED -> CLOSED (nothing signed)
//          doctor says no:      AWAITING_DOCTOR -> DECLINED -> CLOSED (nothing signed)
// Other treatments: QUEUED -> ASSESSMENT -> AWAITING_SIGNATURE -> IN_PROGRESS -> CLOSED
// CONSENTED is the self-service kiosk route, where the patient signs first.
enum CaseStatus {
  QUEUED
  ASSESSMENT
  AWAITING_SIGNATURE
  CONSENTED
  AWAITING_DOCTOR
  IN_PROGRESS
  READY_TO_CLOSE
  REFERRED
  DECLINED
  CLOSED
}

enum CaseOutcome {
  COMPLETED
  REFERRED_VITALS
  DOCTOR_DECLINED
  CANCELLED
}

enum ProblemStatus {
  OPEN
  FIXED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  phone               String?
  passwordHash        String
  role                Role
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  sessions            Session[]
  passkeys            Passkey[]
  appointments        Appointment[]   @relation("DoctorAppointments")
  auditLogs           AuditLog[]
  problemReports      ProblemReport[] @relation("ProblemReporter")
  casesAsPractitioner TreatmentCase[] @relation("CasePractitioner")
  casesAsDoctor       TreatmentCase[] @relation("CaseDoctor")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Fingerprint / face sign-in (WebAuthn passkeys). The fingerprint never leaves
// the device; we only keep the public key the device made for this site.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  // Staff-chosen label such as "Reception tablet".
  deviceName   String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// One-time WebAuthn challenges, found by the hash of a short-lived cookie.
model PasskeyChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  challenge String
  // Set when adding a passkey; empty when signing in.
  userId    String?
  expiresAt DateTime
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
}

model Patient {
  id           String          @id @default(cuid())
  // Encrypted JSON: names, date of birth, contact details, address,
  // emergency contact, medical history and consent details.
  data         String
  emailHash    String?
  phoneHash    String?
  idNumberHash String?
  // Encrypted JPEG data URL of the patient's ID document, if photographed.
  idPhoto      String?
  consentAt    DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  cases        TreatmentCase[]

  @@index([emailHash])
  @@index([phoneHash])
  @@index([idNumberHash])
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  startsAt           DateTime
  durationMinutes    Int               @default(30)
  // Encrypted: the treatment and any notes are health information.
  service            String
  notes              String?
  status             AppointmentStatus @default(BOOKED)
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// One treatment visit, from check-in to closing. Every clinical field is
// encrypted.
model TreatmentCase {
  id                    String       @id @default(cuid())
  // Short number doctors quote when replying on WhatsApp, e.g. "YES 4821".
  code                  String
  type                  CaseType
  status                CaseStatus   @default(QUEUED)
  // Linked at check-in for a returning patient, otherwise once the
  // practitioner has taken their details.
  patientId             String?
  patient               Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Encrypted JSON: patient details, form version, answers and, once signed,
  // the signature image.
  consent               String
  // Encrypted copy of just the treatment (e.g. which IV drip), so the admin
  // overview can count treatments without decrypting whole signed forms.
  // Empty string encrypted when none was chosen; null on older rows until the
  // overview fills it in.
  treatment             String?
  // Encrypted name, treatment and signing time: all the waiting lists show, so
  // they don't fetch and decrypt whole signed forms every few seconds. Null on
  // older rows until a list fills it in.
  summary               String?
  consentEmailedAt      DateTime?
  practitionerId        String?
  practitioner          User?        @relation("CasePractitioner", fields: [practitionerId], references: [id])
  doctorId              String?
  doctor                User?        @relation("CaseDoctor", fields: [doctorId], references: [id])
  preVitals             String?
  preVitalsAt           DateTime?
  vitalsWithinRange     Boolean?
  doctorRequestedAt     DateTime?
  decisionTokenHash     String?      @unique
  decisionTokenExpires  DateTime?
  doctorDecision        Boolean?
  doctorDecisionAt      DateTime?
  doctorDecisionVia     String?
  // Why an answer given by phone was recorded by staff (encrypted).
  doctorDecisionNote    String?
  postVitals            String?
  postVitalsAt          DateTime?
  officeUse             String?
  closingNotes          String?
  practitionerSignature String?
  outcome               CaseOutcome?
  closedAt              DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status])
  @@index([doctorId, status])
  @@index([patientId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A problem a staff member reported from the app. The page path has IDs
// removed, and the staff member's words are encrypted in case they mention a
// patient despite being asked not to.
model ProblemReport {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation("ProblemReporter", fields: [userId], references: [id], onDelete: SetNull)
  role      Role
  path      String
  details   String
  device    String?
  status    ProblemStatus @default(OPEN)
  fixedAt   DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
