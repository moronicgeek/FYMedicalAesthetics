# --- Database (PostgreSQL) ---------------------------------------------------
# Neon: use the pooled connection string for DATABASE_URL and the direct one
# for DIRECT_URL. For a single local database, set both to the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/fymedical"
DIRECT_URL="postgresql://user:password@localhost:5432/fymedical"

# --- Encryption keys (REQUIRED) -------------------------------------------------
# Generate each with: openssl rand -base64 32
# Keep these secret and backed up somewhere safe (e.g. a password manager).
# If ENCRYPTION_KEY is lost, patient records cannot be decrypted.
ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""

# --- Clinic details ------------------------------------------------------------
CLINIC_NAME="FY Medical Aesthetics"
CLINIC_ADDRESS=""
# IANA timezone name, used for all dates and times shown and booked.
CLINIC_TIMEZONE="Africa/Johannesburg"
# Country code used for local phone numbers that start with 0 (27 = South Africa).
DEFAULT_COUNTRY_CODE="27"

# --- Scheduled reminders ----------------------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=""
REMINDER_HOURS_AHEAD="24"

# --- Email (Resend: https://resend.com) ---------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="FY Medical Aesthetics <appointments@yourdomain.com>"

# --- WhatsApp (Twilio: https://twilio.com) ------------------------------------
# Patients' confirmations and reminders, and doctors' IV drip approvals.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The clinic's WhatsApp sender number in international format, e.g. +27100000000
TWILIO_WHATSAPP_FROM=""
# Content SIDs (HX...) of the Meta-approved templates. See README for the wording.
TWILIO_TEMPLATE_BOOKING=""
TWILIO_TEMPLATE_REMINDER=""
TWILIO_TEMPLATE_DOCTOR_APPROVAL=""

# --- Public URL (REQUIRED in production) --------------------------------------
# Used for the doctor's approval link and to verify Twilio webhooks.
APP_URL="https://portal.yourdomain.com"

# --- Clinic inbox for signed consent forms -------------------------------------
CLINIC_INBOX_EMAIL="hello@lumierclinic.co.za"
